APP_NAME=SumbaneCredit
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Maputo
APP_URL=http://localhost:8000

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sumbanecredit
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção com HTTPS: SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Em ambiente local os emails são escritos em storage/logs (MAIL_MAILER=log).
# Para envio real configure um servidor SMTP da instituição.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responder@sumbanecredit.local"
MAIL_FROM_NAME="${APP_NAME}"

# SMS: "log" apenas regista a mensagem no log (NÃO envia). "null" desactiva.
# Um prestador real exige contrato e credenciais próprias.
SMS_DRIVER=log
SMS_SENDER_ID=SumbaneCrd

# Integrações de pagamento (M-Pesa / e-Mola). Sem credenciais, ficam desactivadas
# e os pagamentos são registados manualmente.
MPESA_ENABLED=false
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=
MPESA_BASE_URL=
EMOLA_ENABLED=false
EMOLA_API_KEY=
EMOLA_MERCHANT_CODE=
EMOLA_BASE_URL=

# Contas de demonstração: só são criadas quando APP_ENV=local ou testing.
DEMO_PASSWORD=Demo@2026!
